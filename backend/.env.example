# Server
PORT=3000
NODE_ENV=development

# Allowed origin for CORS — set to your frontend's domain in production,
# e.g. https://www.s-kavovary.sk
CORS_ORIGIN=*

# Gmail SMTP
# Use a Gmail "App Password" (Google Account > Security > 2-Step Verification
# > App passwords), NOT your normal Gmail login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password

# Where new booking notifications are sent (the business inbox)
BUSINESS_EMAIL=alexozaniakk@gmail.com

# Send a confirmation email back to the customer too
SEND_CUSTOMER_CONFIRMATION=true
